    },
    {
      "id": "RiP9YLp2RP2vHTrCU4WSG",
      "type": "text",
      "x": 2445.865559895833,
      "y": 3470.7555934361053,
      "width": 522.62353515625,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 365150317,
      "version": 262,
      "versionNonce": 1460350157,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784640721099,
      "link": null,
      "locked": false,
      "text": "Section commander decides frontal assault \nand the section does several fireteam bounds to get close to the \nenemy. Onefoot on the ground / \nno move without fire to keep the enemey suprsed. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Section commander decides frontal assault \nand the section does several fireteam bounds to get close to the \nenemy. Onefoot on the ground / \nno move without fire to keep the enemey suprsed. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JI4XfOvbTQOhzZG5pzI3k",
      "type": "text",
      "x": 2399.283528645833,
      "y": 6470.482155936106,
      "width": 568.19140625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15V",
      "roundness": null,
      "seed": 2077192141,
      "version": 589,
      "versionNonce": 1951695501,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784642938014,
      "link": null,
      "locked": false,
      "text": "Section commander decides left flanking \nas he can send a fireteam through the woods unobserved by the enemy. \nThe assaulting section peels from inside out. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Section commander decides left flanking \nas he can send a fireteam through the woods unobserved by the enemy. \nThe assaulting section peels from inside out. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
